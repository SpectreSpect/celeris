#version 450
#extension GL_GOOGLE_include_directive : require

/*
    x - индекс внутри таблицы смежности (правая верхняя половина таблицы)
    y - индекс вокселя внутри беспрепятственного пути (в этом шейдере проходимость этого пути и ищется)
*/
layout(local_size_x = 16, local_size_y = 16) in;
