#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform UniformBufferObject {
    mat4 quad_model;
    vec4 target_position_and_falloff;
} ubo;

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D output_texture;

// Replace this function with the MCP visualization formula you need.
vec4 evaluate_formula(vec2 uv)
{
    vec2 p = uv * 2.0 - 1.0;
    float value = 0.5 + 0.5 * sin(12.0 * p.x) * cos(12.0 * p.y);

    // Blue-to-cyan-to-yellow visualization of the scalar value.
    vec3 cold = vec3(0.02, 0.08, 0.35);
    vec3 middle = vec3(0.05, 0.85, 0.80);
    vec3 hot = vec3(1.0, 0.85, 0.05);
    vec3 color = value < 0.5
        ? mix(cold, middle, value * 2.0)
        : mix(middle, hot, (value - 0.5) * 2.0);

    // The quad is centered at the origin in its local XZ plane. Its V texture
    // coordinate runs opposite local Z, matching StaticMeshData::quad_vertices.
    vec4 local_position = vec4(uv.x - 0.5, 0.0, 0.5 - uv.y, 1.0);
    vec3 world_position = (ubo.quad_model * local_position).xyz;

    float distance_to_target = distance(
        world_position,
        ubo.target_position_and_falloff.xyz
    );
    float red_proximity = exp(
        -distance_to_target / ubo.target_position_and_falloff.w
    );

    // color = mix(color, vec3(1.0, 0.0, 0.0), red_proximity);
    color = vec3(red_proximity, 0, 0);

    
    return vec4(color, 1.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texture_size = imageSize(output_texture);

    if (pixel.x >= texture_size.x || pixel.y >= texture_size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(texture_size);
    imageStore(output_texture, pixel, evaluate_formula(uv));
}
