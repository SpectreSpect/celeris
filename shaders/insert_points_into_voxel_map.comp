#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;

struct PointInstance {
    vec4 position;
    vec4 color;
};

#include "common/hash_table/hash_table_decl.inc"
#include "common/utils.inc"
#include "voxel_point_map/index_hash_table/decl.inc"
#include "voxel_point_map/index_hash_table/config_functions/index_key_comp.inc"
#include "voxel_point_map/index_hash_table/config_functions/index_value_init.inc"

layout(std140, set = 0, binding = 0) uniform ParamsBuffer {
    uint source_point_count;
    uint max_map_point_count;
    uint num_hash_table_slots;
    uint pack_bits;
    int pack_offset;
    uint retry_mode;
    mat4 source_model;
    vec4 color;
} params;

layout(std430, set = 0, binding = 1) readonly buffer SourcePointBuffer {
    PointInstance points[];
} source_point_buffer;

layout(std430, set = 0, binding = 2) readonly buffer SourceNormalBuffer {
    vec4 normals[];
} source_normal_buffer;

layout(std430, set = 0, binding = 3) buffer MapPointCountBuffer {
    uint count;
} map_point_count_buffer;

// points[id].position.xyz = mean position of voxel
// points[id].position.w   = number of points accumulated in voxel
// points[id].color        = averaged color, optional
layout(std430, set = 0, binding = 4) buffer MapPointBuffer {
    PointInstance points[];
} map_point_buffer;

// normals[id].xyz = accumulated normal sum
// normals[id].w   = 1.0 if any accumulated source point exceeded the curvature limit
//
// When reading for GICP, use normalize(normals[id].xyz)
layout(std430, set = 0, binding = 5) buffer MapNormalBuffer {
    vec4 normals[];
} map_normal_buffer;

layout(std430, set = 0, binding = 6) coherent buffer PointHashTable {
    HashTableCounters point_hash_table_counters;
    IndexHashTableSlot point_hash_table_slots[];
};

layout(std430, set = 0, binding = 7) buffer InsertDebugBuffer {
    uint hash_table_insert_fail_count;
} insert_debug_buffer;

layout(std430, set = 0, binding = 8) readonly buffer ReadableInsertRetryList {
    uint readable_retry_list_counter;
    uint readable_retry_list[];
};

layout(std430, set = 0, binding = 9) buffer WritableInsertRetryList {
    uint writable_retry_list_counter;
    uint writable_retry_list[];
};

vec3 g_insert_world_position;
vec3 g_insert_world_normal;
float g_insert_curvature_limit_exceeded;
vec4 g_insert_color;

const float MIN_NORMAL_LEN = 0.00001;
const float CURVATURE_LIMIT = 0.05;

// ------------------------------------------------------------
// Validity helpers
// ------------------------------------------------------------

bool valid_float(float x)
{
    return !isnan(x) && !isinf(x);
}

bool valid_vec2(vec2 v)
{
    return valid_float(v.x) &&
           valid_float(v.y);
}

bool valid_vec3(vec3 v)
{
    return valid_float(v.x) &&
           valid_float(v.y) &&
           valid_float(v.z);
}

bool valid_vec4(vec4 v)
{
    return valid_float(v.x) &&
           valid_float(v.y) &&
           valid_float(v.z) &&
           valid_float(v.w);
}

bool valid_normal(vec3 n)
{
    if (!valid_vec3(n))
        return false;

    float len2 = dot(n, n);

    if (!valid_float(len2))
        return false;

    return len2 > MIN_NORMAL_LEN * MIN_NORMAL_LEN;
}

float curvature_limit_exceeded_from_world_normal(vec3 world_normal)
{
    float curvature = 1.0 - max(dot(world_normal, vec3(0.0, 1.0, 0.0)), 0.0);
    return curvature > CURVATURE_LIMIT ? 1.0 : 0.0;
}

// ------------------------------------------------------------
// Voxel helpers
// ------------------------------------------------------------

ivec3 voxel_key_from_world_pos(vec3 world_pos, float voxel_size)
{
    return ivec3(floor(world_pos / voxel_size));
}

uvec2 voxel_hash_table_key(ivec3 key)
{
    return pack_key_uvec2(key, uint(params.pack_offset), params.pack_bits);
}

uint allocate_map_entry_id(uvec2 key, out bool success)
{
    uint entry_id = atomicAdd(map_point_count_buffer.count, 1u);

    if (entry_id >= params.max_map_point_count) {
        atomicAdd(map_point_count_buffer.count, 0xFFFFFFFFu);
        success = false;
        return INVALID_ID;
    }

    success = true;
    return entry_id;
}

void init_map_entry(uint slot_id, uvec2 key, uint entry_id)
{
    map_point_buffer.points[entry_id].position =
        vec4(g_insert_world_position, 1.0);

    map_point_buffer.points[entry_id].color = g_insert_color;
    map_normal_buffer.normals[entry_id] =
        vec4(g_insert_world_normal, g_insert_curvature_limit_exceeded);
}

#define HT_PREFIX point_hash_table
#define SLOT_VALUE_TYPE uint
#define SLOT_KEY_TYPE uvec2
#define SLOT_TYPE IndexHashTableSlot
#define TABLE_COUNTERS point_hash_table_counters
#define SLOTS_BUFFER point_hash_table_slots
#define HASH_TABLE_SIZE params.num_hash_table_slots
#define KEY_HASH_FUNC hash_uvec2
#define KEY_COMP_FUNC index_key_comp
#define VALUE_INIT_FUNC allocate_map_entry_id
#define INIT_SLOT_CALLBACK init_map_entry
#define MAX_CAS_ATTEMPTS 5u

#include "common/hash_table/hash_table_common_impl.inc"
#include "common/hash_table/hash_table_get_or_create_impl.inc"
#include "common/hash_table/hash_table_lookup_remove_impl.inc"

#undef HT_PREFIX
#undef SLOT_VALUE_TYPE
#undef SLOT_KEY_TYPE
#undef SLOT_TYPE
#undef TABLE_COUNTERS
#undef SLOTS_BUFFER
#undef HASH_TABLE_SIZE
#undef KEY_HASH_FUNC
#undef KEY_COMP_FUNC
#undef VALUE_INIT_FUNC
#undef INIT_SLOT_CALLBACK
#undef MAX_CAS_ATTEMPTS

// ------------------------------------------------------------
// Surfel update
// ------------------------------------------------------------

void update_voxel_surfel(
    uint surfel_id,
    vec3 world_position,
    vec3 world_normal,
    float curvature_limit_exceeded,
    vec4 color
) {
    // Defensive checks.
    // This function should only receive valid data, but this prevents
    // accidental corruption if it is called incorrectly.
    if (!valid_vec3(world_position))
        return;

    if (!valid_normal(world_normal))
        return;

    if (!valid_vec4(color))
        return;

    world_normal = normalize(world_normal);

    vec4 old_mean_count = map_point_buffer.points[surfel_id].position;

    vec3 old_mean = old_mean_count.xyz;
    float old_count = old_mean_count.w;

    if (!valid_vec3(old_mean))
        return;

    if (!valid_float(old_count) || old_count < 0.0)
        return;

    float new_count = old_count + 1.0;

    if (!valid_float(new_count) || new_count <= 0.0)
        return;

    // Running mean:
    //
    // new_mean = old_mean + (x - old_mean) / new_count
    vec3 new_mean = old_mean + (world_position - old_mean) / new_count;

    if (!valid_vec3(new_mean))
        return;

    // Optional running average color.
    vec4 old_color = map_point_buffer.points[surfel_id].color;
    vec4 new_color = old_color + (color - old_color) / new_count;

    if (!valid_vec4(new_color))
        return;

    vec4 old_normal = map_normal_buffer.normals[surfel_id];
    vec3 normal_sum = old_normal.xyz;

    if (!valid_vec3(normal_sum))
        return;

    vec3 n = world_normal;

    // If normals are inconsistently oriented, this avoids cancellation.
    //
    // Example:
    //     +Z + -Z = 0
    //
    // This flips incoming normal to agree with accumulated direction.
    if (dot(normal_sum, normal_sum) > 1e-12 && dot(normal_sum, n) < 0.0) {
        n = -n;
    }

    normal_sum += n;

    if (!valid_vec3(normal_sum))
        return;

    map_point_buffer.points[surfel_id].position = vec4(new_mean, new_count);
    map_point_buffer.points[surfel_id].color = new_color;
    map_normal_buffer.normals[surfel_id] =
        vec4(normal_sum, max(old_normal.w, curvature_limit_exceeded));
}

// ------------------------------------------------------------
// Insert point into voxel hash table
// ------------------------------------------------------------

bool voxel_insert_point_and_normal(
    uint source_point_id,
    ivec3 key,
    vec4 world_position4,
    vec4 world_normal4,
    vec4 color
) {
    if (params.num_hash_table_slots == 0u)
        return false;

    vec3 world_position = world_position4.xyz;
    vec3 raw_world_normal = world_normal4.xyz;

    // Defensive invalid-data rejection.
    if (!valid_vec3(world_position))
        return false;

    if (!valid_normal(raw_world_normal))
        return false;

    if (!valid_vec4(color))
        return false;

    vec3 world_normal = normalize(raw_world_normal);

    if (!valid_normal(world_normal))
        return false;

    uvec2 hash_key = voxel_hash_table_key(key);

    g_insert_world_position = world_position;
    g_insert_world_normal = world_normal;
    g_insert_curvature_limit_exceeded =
        curvature_limit_exceeded_from_world_normal(world_normal);
    g_insert_color = color;

    uint slot_id;
    bool created;
    if (!point_hash_table_get_or_create_slot(hash_key, slot_id, created)) {
        atomicAdd(insert_debug_buffer.hash_table_insert_fail_count, 1u);
        uint retry_id = atomicAdd(writable_retry_list_counter, 1u);
        writable_retry_list[retry_id] = source_point_id;
        return false;
    }

    uint surfel_id = point_hash_table_slots[slot_id].value;
    if (surfel_id == INVALID_ID)
        return false;

    if (created) {
        return true;
    }

    uint prev = atomicCompSwap(
        point_hash_table_slots[slot_id].state,
        SLOT_OCCUPIED,
        SLOT_LOCKED
    );

    if (prev != SLOT_OCCUPIED)
        return false;

    update_voxel_surfel(
        surfel_id,
        world_position,
        world_normal,
        g_insert_curvature_limit_exceeded,
        color
    );

    memoryBarrierBuffer();

    atomicExchange(
        point_hash_table_slots[slot_id].state,
        SLOT_OCCUPIED
    );

    return true;
}

// ------------------------------------------------------------
// Main
// ------------------------------------------------------------

void main()
{
    uint work_id = gl_GlobalInvocationID.x;
    uint source_point_id;

    if (params.retry_mode != 0u) {
        if (work_id >= readable_retry_list_counter)
            return;

        source_point_id = readable_retry_list[work_id];
    } else {
        source_point_id = work_id;

        if (source_point_id >= params.source_point_count)
            return;
    }

    PointInstance src_point = source_point_buffer.points[source_point_id];
    vec4 src_normal4 = source_normal_buffer.normals[source_point_id];

    // Reject invalid color first.
    // This also catches NaN/Inf colors before they poison running averages.
    if (!valid_vec4(src_point.color))
        return;

    // Skip missed rays / invalid generated points.
    if (src_point.color.a <= 0.001)
        return;

    vec3 p_local = src_point.position.xyz;
    vec3 n_local = src_normal4.xyz;

    // Reject NaN/Inf positions.
    if (!valid_vec3(p_local))
        return;

    // Reject NaN/Inf/zero normals.
    if (!valid_normal(n_local))
        return;

    float n_len = length(n_local);

    if (!valid_float(n_len) || n_len <= MIN_NORMAL_LEN)
        return;

    float voxel_size = 0.5;

    vec3 p_world = (params.source_model * vec4(p_local, 1.0)).xyz;

    // Reject bad transformed positions before hashing.
    // Very important: do not compute voxel key from NaN/Inf.
    if (!valid_vec3(p_world))
        return;

    mat3 normal_matrix = transpose(inverse(mat3(params.source_model)));

    vec3 n_world_raw = normal_matrix * (n_local / n_len);

    if (!valid_normal(n_world_raw))
        return;

    vec3 n_world = normalize(n_world_raw);

    if (!valid_normal(n_world))
        return;

    ivec3 key = voxel_key_from_world_pos(p_world, voxel_size);

    bool result = voxel_insert_point_and_normal(
        source_point_id,
        key,
        vec4(p_world, 1.0),
        vec4(n_world, 0.0),
        src_point.color
    );
}
