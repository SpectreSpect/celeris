#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;

// // ----- include -----
#include "../common/buffer_structures.inc"
// // -------------------

// struct VoxelWrite {
//     ivec4 world_voxel; // xyz use, w unused
//     VoxelData voxel_data;
//     uint set_flags;
//     uint _pad1;
// };

struct PointInstance {
    vec4 position;
    vec4 color;
};

layout(std430, set = 0, binding = 0) readonly buffer SourcePointBuffer {
    PointInstance points[];
} source_point_buffer;

layout(std430, set = 0, binding = 1) readonly buffer SourceNormalBuffer {
    vec4 normals[];
} source_normal_buffer;

layout(std430, set = 0, binding = 2) buffer TargetVoxelWrites {
    uint count_voxel_writes;
    uint pad_[3u];
    VoxelWrite voxel_writes[];
} voxel_write_list;


layout(push_constant) uniform VoxelListFromPointCloudPushConstants {
    mat4 source_point_cloud_model;
    vec4 voxel_size;
    uint point_count;
    uint max_write_count;
};

float random01(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;

    return float(value) / 4294967295.0;
}

bool valid_normal(vec3 normal) {
    if (any(isnan(normal)) || any(isinf(normal))) {
        return false;
    }

    return dot(normal, normal) > 1e-12;
}

vec3 source_normal_to_world(vec3 normal) {
    vec3 source_normal = normalize(normal);
    mat3 normal_matrix = transpose(inverse(mat3(source_point_cloud_model)));
    vec3 world_normal = normal_matrix * source_normal;

    return normalize(world_normal);
}

void main() {
    uint point_id = gl_GlobalInvocationID.x;

    if (point_id >= point_count) return;
    if (point_id >= max_write_count) return;

    vec4 normal = source_normal_buffer.normals[point_id];
    if (!valid_normal(normal.xyz)) return;

    vec3 world_normal = source_normal_to_world(normal.xyz);
    if (!valid_normal(world_normal)) return;

    float curvature = 1.0 - max(dot(world_normal, vec3(0.0, 1.0, 0.0)), 0);
    float curvature_limit = 0.05;

    vec3 world_pos = (source_point_cloud_model * source_point_buffer.points[point_id].position).xyz;
    vec3 local = world_pos / voxel_size.xyz;

    ivec4 voxel_pos = ivec4(ivec3(floor(local)), 1);

    VoxelData voxel_data;

    uint voxel_flags = VOXEL_VISABILITY_FLAG_BIT;
    
    if (curvature > curvature_limit) {
        voxel_flags |= VOXEL_CURVATURE_LIMIT_EXCEEDED_BIT;
    }
    
    voxel_data.type_flags = pack_voxel_type_flags(1u, voxel_flags);

    vec3 base_color = vec3(0.0, 98.0, 255.0) * (0.5 + random01(point_id) * 0.5);
    vec3 color = curvature > curvature_limit ? base_color : vec3(0.0, 0.0, 0.0);
    uvec3 packed_color = uvec3(color);

    voxel_data.color = (packed_color.r << 24u) | (packed_color.g << 16u) | (packed_color.b << 8u) | 255u;

    uint voxel_write_id = atomicAdd(voxel_write_list.count_voxel_writes, 1u);
    voxel_write_list.voxel_writes[voxel_write_id].world_voxel = voxel_pos;
    voxel_write_list.voxel_writes[voxel_write_id].voxel_data = voxel_data;
    voxel_write_list.voxel_writes[voxel_write_id].set_flags =
        OVERWRITE_BIT | CURVATURE_PRIORITY_OVERWRITE_BIT;
    voxel_write_list.voxel_writes[voxel_write_id]._pad1 = 0u;
}
