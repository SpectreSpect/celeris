#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;

// ----- include -----
#include "../common/buffer_structures.inc"
// -------------------

layout(std430, set = 0, binding=0) coherent buffer ChunkHashTable { HashTableCounters chunk_hash_table_counters; ChunkHashTableSlot chunk_hash_table_slots[]; };
layout(std430, set = 0, binding=1) buffer FreeList { uint free_count; uint free_list[]; };
layout(std430, set = 0, binding=2) buffer ChunkMetaBuf { ChunkMeta meta[]; };
layout(std430, set = 0, binding=3) buffer EnqueuedBuf { uint enqueued[]; };
layout(std430, set = 0, binding=4) buffer DirtyListBuf { uint dirty_count; uint dirty_list[]; };

layout(std430, set = 0, binding=5) readonly buffer VoxelsWriteData { uint count_voxel_writes; uint pad_[3u]; VoxelWrite voxel_writes[]; };
layout(std430, set = 0, binding=6) buffer ChunkVoxels { VoxelData voxels[]; };
layout(std430, set = 0, binding=7) buffer ToInflateListBuf { uint to_inflate_count; uint to_inflate_list[]; };

layout(push_constant) uniform WriteVoxelsToGridPushConstants {
    ivec4 u_chunk_dim;
    uint u_chunk_hash_table_size;

    uint u_voxels_per_chunk;

    uint u_pack_offset;
    uint u_pack_bits;
    uint u_mark_recently_inserted;
};

// ----- include -----
#include "../common/utils.inc"

#include "chunk_hash_table/common.inc"
#include "chunk_hash_table/get_or_create.inc"
#include "chunk_hash_table/lookup_remove.inc"

#include "chunk_pool/mark_dirty.inc"
#include "chunk_pool/voxel_index.inc"
// -------------------

bool has_curvature_limit_exceeded(uint type_flags) {
    return (read_voxel_flags(type_flags) & VOXEL_CURVATURE_LIMIT_EXCEEDED_BIT) != 0u;
}

void atomic_store_voxel(uint global_voxel_id, VoxelData voxel_data) {
    while (true) {
        uint old_type_flags = atomicAdd(voxels[global_voxel_id].type_flags, 0u);
        if (atomicCompSwap(
            voxels[global_voxel_id].type_flags,
            old_type_flags,
            voxel_data.type_flags
        ) == old_type_flags) {
            atomicExchange(voxels[global_voxel_id].color, voxel_data.color);
            return;
        }
    }
}

bool atomic_store_voxel_with_curvature_priority(uint global_voxel_id, VoxelData voxel_data) {
    bool write_has_curvature_limit = has_curvature_limit_exceeded(voxel_data.type_flags);

    while (true) {
        uint old_type_flags = atomicAdd(voxels[global_voxel_id].type_flags, 0u);
        if (has_curvature_limit_exceeded(old_type_flags) && !write_has_curvature_limit) {
            return false;
        }

        if (atomicCompSwap(
            voxels[global_voxel_id].type_flags,
            old_type_flags,
            voxel_data.type_flags
        ) == old_type_flags) {
            atomicExchange(voxels[global_voxel_id].color, voxel_data.color);
            return true;
        }
    }
}

bool atomic_store_voxel_if_easy_overwrite(uint global_voxel_id, VoxelData voxel_data) {
    while (true) {
        uint old_type_flags = atomicAdd(voxels[global_voxel_id].type_flags, 0u);
        if ((read_voxel_flags(old_type_flags) & VOXEL_EASY_OVERWRITE_FLAG_BIT) == 0u) {
            return false;
        }

        if (atomicCompSwap(
            voxels[global_voxel_id].type_flags,
            old_type_flags,
            voxel_data.type_flags
        ) == old_type_flags) {
            atomicExchange(voxels[global_voxel_id].color, voxel_data.color);
            return true;
        }
    }
}

void main() {
    uint voxel_write_id = gl_GlobalInvocationID.x;
    if (voxel_write_id >= count_voxel_writes) return;

    VoxelWrite voxel_write = voxel_writes[voxel_write_id];
    ivec3 chunk_pos = floor_div(voxel_write.world_voxel.xyz, u_chunk_dim.xyz);
    ivec3 local_voxel_pos = voxel_write.world_voxel.xyz - chunk_pos * u_chunk_dim.xyz;
    
    uvec2 key = pack_key_uvec2(chunk_pos, u_pack_offset, u_pack_bits);

    uint slot_id;
    bool created;
    if (!chunk_hash_table_get_or_create_slot(key, slot_id, created)) return;

    uint chunk_id = chunk_hash_table_slots[slot_id].value;
    
    uint voxel_id = voxel_index(local_voxel_pos);
    uint global_voxel_id = chunk_id * u_voxels_per_chunk + voxel_id;
    VoxelData voxel_data = voxel_write.voxel_data;
    if (u_mark_recently_inserted != 0u) {
        voxel_data.type_flags |= VOXEL_RECENTLY_INSERTED_BIT << VOXEL_TYPE_BITS;
    }

    bool wrote_voxel = false;

    if ((voxel_write.set_flags & OVERWRITE_BIT) > 0u) {
        if ((voxel_write.set_flags & CURVATURE_PRIORITY_OVERWRITE_BIT) > 0u) {
            wrote_voxel = atomic_store_voxel_with_curvature_priority(global_voxel_id, voxel_data);
        } else {
            atomic_store_voxel(global_voxel_id, voxel_data);
            wrote_voxel = true;
        }
    }
    else {
        wrote_voxel = atomic_store_voxel_if_easy_overwrite(global_voxel_id, voxel_data);
    }

    if (wrote_voxel) {
        mark_dirty_mesh_around(chunk_id, chunk_pos);
    }
}
