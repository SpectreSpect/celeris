#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;

// ----- include -----
#include "../common/buffer_structures.inc"
// -------------------

layout(std430, set = 0, binding = 0) coherent buffer ChunkHashTable { HashTableCounters chunk_hash_table_counters; ChunkHashTableSlot chunk_hash_table_slots[]; };
layout(std430, set = 0, binding = 1) buffer ChunkVoxels { VoxelData voxels[]; };
layout(std430, set = 0, binding = 2) readonly buffer ToInflateListBuf { uint to_inflate_count; uint to_inflate_list[]; };
layout(std430, set = 0, binding = 3) buffer ChunkMetaBuf { ChunkMeta meta[]; };
layout(std430, set = 0, binding = 4) buffer EnqueuedBuf { uint enqueued[]; };

layout(push_constant) uniform InflateChunksPushConstants {
    ivec4 u_chunk_dim;
    uint u_chunk_hash_table_size;
    uint u_voxels_per_chunk;
    uint u_pack_offset;
    uint u_pack_bits;
    uint u_inflation_size;
    uint u_car_height_voxels;
};

// ----- include -----
#include "chunk_pool/read_voxels.inc"
// -------------------

bool intersects_inflated_solid(ivec3 target_world_voxel)
{
    int radius = int(u_inflation_size);
    int car_height_voxels = int(u_car_height_voxels);

    for (int height_offset = 0; height_offset < car_height_voxels; ++height_offset) {
        for (int z = -radius; z <= radius; ++z) {
            for (int x = -radius; x <= radius; ++x) {
                ivec3 source_world_voxel = target_world_voxel + ivec3(x, height_offset, z);
                if (voxel_vis(source_world_voxel) != 0u) return true;
            }
        }
    }

    return false;
}

void main()
{
    uint to_inflate_id = gl_GlobalInvocationID.x;
    uint voxel_id = gl_GlobalInvocationID.y;
    if (to_inflate_id >= to_inflate_count) return;
    if (voxel_id >= u_voxels_per_chunk) return;

    uint target_chunk_id = to_inflate_list[to_inflate_id];
    uint target_global_voxel_id = target_chunk_id * u_voxels_per_chunk + voxel_id;
    uint inflated_type_flag = VOXEL_INFLATED_BIT << VOXEL_TYPE_BITS;

    atomicAnd(voxels[target_global_voxel_id].type_flags, ~inflated_type_flag);

    ivec3 target_chunk_pos = unpack_key_to_coord(
        uvec2(meta[target_chunk_id].key_lo, meta[target_chunk_id].key_hi),
        u_pack_offset,
        u_pack_bits
    );
    ivec3 target_local_pos = local_voxel_pos_from_index(voxel_id);
    ivec3 target_world_voxel = target_chunk_pos * u_chunk_dim.xyz + target_local_pos;

    if (intersects_inflated_solid(target_world_voxel)) {
        atomicOr(voxels[target_global_voxel_id].type_flags, inflated_type_flag);
    }

    if (voxel_id == 0u) {
        atomicAnd(meta[target_chunk_id].dirty_flags, ~DIRTY_INFLATE_FLAG_BIT);
        atomicAnd(enqueued[target_chunk_id], ~DIRTY_INFLATE_FLAG_BIT);
    }
}
